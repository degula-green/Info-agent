{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-agent.local/contracts/knowledge-item.schema.json",
  "title": "KnowledgeItem",
  "type": "object",
  "required": ["knowledge_item_id", "knowledge_scope", "access_scope", "owner_user_id", "organization_id", "source", "content_ref", "content_type", "content_hash", "content_version", "lifecycle_status", "security_status", "acl_version", "attachments"],
  "properties": {
    "knowledge_item_id": {"type": "string", "minLength": 1},
    "knowledge_scope": {"type": "string", "enum": ["private", "organization"]},
    "access_scope": {"type": "string", "enum": ["owner_only", "organization_members", "conversation_members"]},
    "owner_user_id": {"type": ["string", "null"], "minLength": 1},
    "organization_id": {"type": ["string", "null"], "minLength": 1},
    "source": {
      "type": "object",
      "required": ["source_type", "platform", "conversation_id", "external_message_id", "sender_identity_id", "upload_destination"],
      "properties": {
        "source_type": {"type": "string", "enum": ["platform_conversation", "private_conversation", "local_upload", "shared_private_item"]},
        "platform": {"type": "string", "enum": ["feishu", "wecom", "wechat", "local"]},
        "conversation_id": {"type": ["string", "null"], "minLength": 1},
        "external_message_id": {"type": ["string", "null"], "minLength": 1},
        "sender_identity_id": {"type": ["string", "null"], "minLength": 1},
        "upload_destination": {"type": ["string", "null"], "enum": ["private_local_library", "organization_file_library", null]}
      },
      "additionalProperties": false
    },
    "content_ref": {"type": "string", "minLength": 1},
    "content_type": {"type": "string", "enum": ["text", "file", "image", "spreadsheet", "mixed"]},
    "content_hash": {"type": "string", "pattern": "^sha256:.+"},
    "content_version": {"type": "integer", "minimum": 1},
    "lifecycle_status": {"type": "string", "enum": ["active", "deleted"]},
    "security_status": {"type": "string", "enum": ["not_required", "pending", "processing", "classified", "failed"]},
    "sensitivity": {"type": ["string", "null"], "enum": ["public", "internal", "confidential", "restricted", null]},
    "acl_version": {"type": "integer", "minimum": 0},
    "sharing": {
      "type": ["object", "null"],
      "properties": {
        "share_request_id": {"type": "string", "minLength": 1},
        "share_batch_id": {"type": "string", "minLength": 1},
        "source_private_item_id": {"type": "string", "minLength": 1},
        "source_private_conversation_id": {"type": "string", "minLength": 1},
        "shared_at": {"type": "string", "format": "date-time"}
      },
      "required": ["share_request_id", "share_batch_id", "source_private_item_id", "source_private_conversation_id", "shared_at"],
      "additionalProperties": false
    },
    "attachments": {"type": "array", "items": {"$ref": "#/$defs/attachmentRef"}}
  },
  "allOf": [
    {
      "if": {"properties": {"knowledge_scope": {"const": "private"}}},
      "then": {"properties": {"owner_user_id": {"type": "string", "minLength": 1}, "organization_id": {"type": "null"}, "access_scope": {"const": "owner_only"}, "sharing": {"type": "null"}}}
    },
    {
      "if": {"properties": {"knowledge_scope": {"const": "organization"}}},
      "then": {"properties": {"owner_user_id": {"type": "null"}, "organization_id": {"type": "string", "minLength": 1}, "access_scope": {"enum": ["organization_members", "conversation_members"]}}}
    },
    {
      "if": {"properties": {"source": {"properties": {"source_type": {"const": "platform_conversation"}}}}},
      "then": {"properties": {"knowledge_scope": {"const": "organization"}, "access_scope": {"const": "conversation_members"}, "sharing": {"type": "null"}}}
    },
    {
      "if": {"properties": {"source": {"properties": {"source_type": {"const": "private_conversation"}}}}},
      "then": {"properties": {"knowledge_scope": {"const": "private"}, "access_scope": {"const": "owner_only"}, "sharing": {"type": "null"}}}
    },
    {
      "if": {"properties": {"source": {"properties": {"source_type": {"const": "local_upload"}}}}},
      "then": {"properties": {"content_type": {"enum": ["file", "image", "spreadsheet", "mixed"]}, "source": {"properties": {"platform": {"const": "local"}, "conversation_id": {"type": "null"}, "external_message_id": {"type": "null"}}, "required": ["upload_destination"]}, "attachments": {"minItems": 1}, "sharing": {"type": "null"}}}
    },
    {
      "if": {"properties": {"source": {"properties": {"source_type": {"const": "local_upload"}, "upload_destination": {"const": "private_local_library"}}}}},
      "then": {"properties": {"knowledge_scope": {"const": "private"}, "access_scope": {"const": "owner_only"}}}
    },
    {
      "if": {"properties": {"source": {"properties": {"source_type": {"const": "local_upload"}, "upload_destination": {"const": "organization_file_library"}}}}},
      "then": {"properties": {"knowledge_scope": {"const": "organization"}, "access_scope": {"const": "organization_members"}}}
    },
    {
      "if": {"properties": {"source": {"properties": {"source_type": {"const": "shared_private_item"}}}}},
      "then": {"required": ["sharing"], "properties": {"knowledge_scope": {"const": "organization"}, "access_scope": {"const": "organization_members"}, "sharing": {"type": "object"}}}
    },
    {
      "if": {"properties": {"knowledge_scope": {"const": "private"}}},
      "then": {"properties": {"attachments": {"items": {"properties": {"access_scope": {"const": "owner_only"}}}}}}
    },
    {
      "if": {"properties": {"source": {"properties": {"source_type": {"const": "local_upload"}, "upload_destination": {"const": "private_local_library"}}}}},
      "then": {"properties": {"attachments": {"items": {"properties": {"access_scope": {"const": "owner_only"}, "source_private_attachment_id": {"type": "null"}}}}}}
    },
    {
      "if": {"properties": {"source": {"properties": {"source_type": {"const": "local_upload"}, "upload_destination": {"const": "organization_file_library"}}}}},
      "then": {"properties": {"attachments": {"items": {"properties": {"access_scope": {"const": "organization_members"}, "source_private_attachment_id": {"type": "null"}}}}}}
    },
    {
      "if": {"properties": {"source": {"properties": {"source_type": {"const": "private_conversation"}}}}},
      "then": {"properties": {"attachments": {"items": {"properties": {"access_scope": {"const": "owner_only"}, "source_private_attachment_id": {"type": "null"}}}}}}
    },
    {
      "if": {"properties": {"source": {"properties": {"source_type": {"const": "platform_conversation"}}}}},
      "then": {"properties": {"attachments": {"items": {"properties": {"source_private_attachment_id": {"type": "null"}}}}}}
    },
    {
      "if": {"properties": {"source": {"properties": {"source_type": {"const": "shared_private_item"}}}}},
      "then": {"properties": {"attachments": {"items": {"properties": {"access_scope": {"const": "organization_members"}, "source_private_attachment_id": {"type": "string", "minLength": 1}}}}}}
    },
    {
      "if": {"properties": {"source": {"properties": {"source_type": {"enum": ["platform_conversation", "private_conversation", "shared_private_item"]}}}}},
      "then": {"properties": {"source": {"properties": {"upload_destination": {"type": "null"}}}}}
    }
  ],
  "$defs": {
    "attachmentRef": {
      "type": "object",
      "required": ["attachment_id", "source_private_attachment_id", "file_name", "mime_type", "size_bytes", "object_ref", "content_hash", "content_version", "access_scope", "acl_version"],
      "properties": {
        "attachment_id": {"type": "string", "minLength": 1},
        "source_private_attachment_id": {"type": ["string", "null"], "minLength": 1},
        "file_name": {"type": "string", "minLength": 1},
        "mime_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "object_ref": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:.+"},
        "content_version": {"type": "integer", "minimum": 1},
        "access_scope": {"type": "string", "enum": ["owner_only", "organization_members", "conversation_members"]},
        "acl_version": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {"if": {"properties": {"source_private_attachment_id": {"type": "string"}}}, "then": {"properties": {"access_scope": {"const": "organization_members"}}}}
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
