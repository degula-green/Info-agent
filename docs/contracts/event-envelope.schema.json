{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-agent.local/contracts/event-envelope.schema.json",
  "title": "EventEnvelope",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "trace_id", "organization_id", "producer", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "enum": ["privacy.scan.requested", "document.processing.requested", "document.extracted", "private.conversation.share.requested", "knowledge.ready", "processing.completed", "processing.failed"]},
    "schema_version": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": ["string", "null"], "minLength": 1},
    "producer": {"type": "string", "enum": ["module-1", "module-2", "module-3"]},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
