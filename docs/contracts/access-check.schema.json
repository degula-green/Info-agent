{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-agent.local/contracts/access-check.schema.json",
  "title": "AccessCheckRequest",
  "type": "object",
  "required": ["organization_id", "resource_type", "resource_id", "action", "subject_type", "subject_id"],
  "properties": {
    "organization_id": {"type": ["string", "null"], "minLength": 1},
    "resource_type": {"type": "string", "enum": ["message", "attachment", "knowledge_item", "spreadsheet"]},
    "resource_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "enum": ["view", "download"]},
    "subject_type": {"type": "string", "enum": ["user", "service"]},
    "subject_id": {"type": "string", "minLength": 1},
    "acl_version": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
