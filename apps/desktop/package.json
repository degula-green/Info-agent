{
  "name": "info-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build:web": "npm --prefix ../web run build:desktop",
    "build:sidecars": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sidecars.ps1",
    "dist": "npm run build:web && npm run build:sidecars && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  }
}
