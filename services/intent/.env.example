LAYA_HOST=127.0.0.1
LAYA_PORT=8110
LAYA_DEVICE=auto
LAYA_PRELOAD=1
LAYA_MODELS=multilingual
LAYA_REVISION=e4e9ddf21a7b1903b7acffd8814ad4307bf63a67
# Optional local fine-tuned checkpoint. When set, LAYA_REVISION is ignored.
