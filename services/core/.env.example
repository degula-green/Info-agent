CORE_REDIS_DATABASE=1
CORE_REDIS_URL=redis://127.0.0.1:6379/1
CORE_REDIS_KEY_PREFIX=info-agent:auth
CORE_DATABASE_URL=postgresql://127.0.0.1:5432/info_agent
CORE_DATABASE_SCHEMA=public
CORE_JWT_PRIVATE_KEY_FILE=./.runtime/jwt-private.pem
CORE_JWT_PUBLIC_KEY_FILE=./.runtime/jwt-public.pem
CORE_JWT_ISSUER=info-agent-core
CORE_JWT_AUDIENCE=info-agent-api
CORE_JWT_KEY_ID=v1
CORE_ACCESS_TOKEN_TTL=15m
CORE_REFRESH_TOKEN_TTL=168h
CORE_REFRESH_COOKIE_NAME=info_agent_refresh
CORE_REFRESH_COOKIE_PATH=/api/core/auth
CORE_REFRESH_COOKIE_DOMAIN=
CORE_REFRESH_COOKIE_SECURE=true
CORE_REFRESH_COOKIE_SAME_SITE=lax
CORE_MINIO_ENDPOINT=127.0.0.1:9000
CORE_MINIO_ACCESS_KEY=
CORE_MINIO_SECRET_KEY=
CORE_MINIO_BUCKET=info-agent
CORE_OPENFGA_URL=http://127.0.0.1:8081
CORE_OPENFGA_STORE_ID=replace-with-openfga-store-id
CORE_OPENFGA_MODEL_ID=replace-with-openfga-model-id
CORE_OPENFGA_API_TOKEN=replace-with-openfga-api-token
CORE_RAG_AUTHZ_TOKEN=replace-with-rag-service-token
