# Core access-token verification for Agent user-facing HTTP routes.
# In local development start-dev.ps1 resolves this to Core's generated public key.
AGENT_JWT_PUBLIC_KEY_FILE=C:\absolute\path\to\core\.runtime\jwt-public.pem
AGENT_JWT_ISSUER=info-agent-core
AGENT_JWT_AUDIENCE=info-agent-api

# Credential used only to resolve the authenticated user's current organization.
AGENT_CORE_BASE_URL=http://127.0.0.1:8080
AGENT_CORE_TIMEOUT_SECONDS=5

AGENT_DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/info-agent?sslmode=disable
AGENT_DATABASE_SCHEMA=agent
AGENT_REDIS_URL=redis://127.0.0.1:6379/1
AGENT_REDIS_DATABASE=1
AGENT_KNOWLEDGE_BASE_URL=http://127.0.0.1:8090
AGENT_KNOWLEDGE_SERVICE_TOKEN=local-development-only

# Agent-to-RAG read-only knowledge tools. Disabled by default for staged rollout.
AGENT_RAG_BASE_URL=http://127.0.0.1:8000
AGENT_RAG_SERVICE_TOKEN=local-development-only
AGENT_RAG_TIMEOUT_SECONDS=30
# `routing` keeps knowledge tool selection deterministic and delegates
# everything else to the LLM planner when LLM_BASE_URL and LLM_MODEL are set.
AGENT_PLANNER_PROVIDER=routing
RAG_AGENT_METADATA_TOOLS_ENABLED=true

# 意图识别：off | shadow | enforce；rules | llm | laya | jev | hybrid。
# hybrid 用 PRIMARY 选择快速分类器（laya 或 jev），不确定时回退 LLM。
AGENT_UNDERSTANDING_MODE=off
AGENT_UNDERSTANDING_PROVIDER=rules
AGENT_UNDERSTANDING_PRIMARY=laya

# Jev（TypeSafe System One，经 AIHubMix 调用）。启用方式：
# AGENT_UNDERSTANDING_PROVIDER=jev，或 hybrid + AGENT_UNDERSTANDING_PRIMARY=jev。
# 官方入口 https://aihubmix.com/v1；主域名不可达时可改用备用域名
# https://api.inferera.com/v1（Key 与请求体不变）。
AGENT_JEV_BASE_URL=https://aihubmix.com/v1
AGENT_JEV_API_KEY=
AGENT_JEV_MODEL=jev-1.13
AGENT_JEV_TIMEOUT_SECONDS=10
AGENT_JEV_MIN_CONFIDENCE=0.90
AGENT_JEV_MIN_MARGIN=0.15
