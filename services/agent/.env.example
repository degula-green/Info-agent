# Agent service configuration. Copy to .env and fill in the deployment values.
#
# The defaults here mirror app/config.py. Anything left unset keeps its default,
# so this file doubles as the list of knobs that actually matter.

AGENT_ENV=development
AGENT_LOG_LEVEL=INFO
AGENT_HTTP_HOST=0.0.0.0
AGENT_HTTP_PORT=8095

# Storage. Without PostgreSQL/Redis the service falls back to in-memory stores
# and a no-op publisher, which is fine locally and wrong in production.
AGENT_DATABASE_URL=
AGENT_DATABASE_SCHEMA=agent
AGENT_REDIS_URL=
AGENT_REDIS_INBOUND_STREAM=agent:tasks
AGENT_REDIS_BLOCK_MS=1000
AGENT_DEFAULT_TIMEZONE=Asia/Shanghai

AGENT_KNOWLEDGE_BASE_URL=http://127.0.0.1:8090
AGENT_KNOWLEDGE_SERVICE_TOKEN=

# Temporary multimodal attachments and generated reports.
AGENT_ATTACHMENT_MINIO_BUCKET=agent-temp
AGENT_MINIO_ENDPOINT=123.57.175.182:9000
AGENT_MINIO_ACCESS_KEY=CHANGE_ME
AGENT_MINIO_SECRET_KEY=CHANGE_ME

# server: call AGENT_FORM_BROWSER_URL directly.
# desktop: queue atomic browser operations for a paired Electron device.
AGENT_FORM_BROWSER_MODE=server
AGENT_DESKTOP_TASK_TTL_SECONDS=300
AGENT_DESKTOP_TASK_LEASE_SECONDS=60
AGENT_DESKTOP_TASK_POLL_SECONDS=1

# Understanding. "off" never runs the model; "shadow" records its answer without
# changing planning; "enforce" lets it decide the intent.
AGENT_UNDERSTANDING_MODE=off
AGENT_UNDERSTANDING_PROVIDER=laya
# hybrid 用 PRIMARY 选择快速分类器（laya 或 jev），不确定时回退 LLM。
AGENT_UNDERSTANDING_PRIMARY=laya
AGENT_LAYAYA_BASE_URL=http://127.0.0.1:8110
AGENT_LAYAYA_API_KEY=
AGENT_LAYAYA_MODEL=multilingual
AGENT_LAYAYA_MODEL_PATH=services/intent/models/laya-intent-v6
AGENT_LAYAYA_MIN_CONFIDENCE=0.90
AGENT_LAYAYA_MIN_MARGIN=0.15
AGENT_UNDERSTANDING_MIN_CONFIDENCE=0.70
AGENT_UNDERSTANDING_MIN_CONFIDENCE_COLLECTED=0.85

# Jev（TypeSafe System One，经 AIHubMix 调用）。启用方式：
# AGENT_UNDERSTANDING_PROVIDER=jev，或 hybrid + AGENT_UNDERSTANDING_PRIMARY=jev。
# 官方入口 https://aihubmix.com/v1；主域名不可达时可改用备用域名
# https://api.inferera.com/v1（Key 与请求体不变）。
AGENT_JEV_BASE_URL=https://aihubmix.com/v1
AGENT_JEV_API_KEY=
AGENT_JEV_MODEL=jev-1.13
AGENT_JEV_TIMEOUT_SECONDS=10
AGENT_JEV_MAX_RETRIES=2
AGENT_JEV_MIN_CONFIDENCE=0.90
AGENT_JEV_MIN_MARGIN=0.15

# Planner. "routing" keeps collected messages on the deterministic planner and
# sends only chat turns whose intent needs composition to the model.
AGENT_PLANNER_PROVIDER=routing
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_TIMEOUT_SECONDS=10
AGENT_LLM_PLANNER_RESPONSE_FORMAT=json_schema
AGENT_LLM_JSON_SCHEMA_FALLBACK=true

# Agent knowledge retrieval. "tree_first" is the global default: content
# questions use knowledge.search_tree and fall back to knowledge.search_content
# when the tree has no scope. Set "content" to roll back.
AGENT_KNOWLEDGE_RETRIEVAL_MODE=tree_first
# Traditional retrieval score floor. RRF has no absolute scale, so leave 0
# until a labelled sample has been used to calibrate a deployment threshold.
AGENT_KNOWLEDGE_MIN_ANSWER_SCORE=0.0

# Conversation memory Phase 1: same-conversation recent messages + rolling
# summary. These settings do not enable cross-session memory.
AGENT_CONVERSATION_CONTEXT_ENABLED=true
AGENT_CONVERSATION_CONTEXT_RECENT_MAX_TOKENS=4000
AGENT_CONVERSATION_CONTEXT_SUMMARY_MAX_TOKENS=1000
AGENT_CONVERSATION_CONTEXT_MAX_MESSAGES=20
AGENT_CONVERSATION_TITLE_ENABLED=true
AGENT_CONVERSATION_TITLE_MAX_CHARS=24
AGENT_CONVERSATION_TITLE_MAX_OUTPUT_TOKENS=80
AGENT_CONVERSATION_SUMMARY_ENABLED=true
AGENT_CONVERSATION_SUMMARY_MIN_MESSAGES=10
AGENT_CONVERSATION_SUMMARY_TARGET_TOKENS=600
AGENT_CONVERSATION_SUMMARY_MAX_OUTPUT_TOKENS=800
AGENT_CONVERSATION_SUMMARY_LEASE_SECONDS=120
AGENT_CONVERSATION_SUMMARY_RETRY_SECONDS=30
AGENT_CONVERSATION_SUMMARY_MAX_ATTEMPTS=5

# Conversation memory Phase 2: conversation-scoped structured memory.
AGENT_CONVERSATION_MEMORY_ENABLED=true
AGENT_CONVERSATION_MEMORY_TOP_K=5
AGENT_CONVERSATION_MEMORY_MAX_CONTENT_CHARS=4000

# Task-level concurrency. The supervisor starts this many independent Worker
# processes. Each Worker still executes one Task at a time.
AGENT_TASK_WORKER_PROCESSES=4

# Plan-level concurrency. Keep disabled until functional and load tests pass.
AGENT_TASK_PARALLEL_ENABLED=false
AGENT_TASK_STEP_CONCURRENCY=4

# Outbox publishing lease. A crashed dispatcher is reclaimed after this window.
AGENT_OUTBOX_CLAIM_LEASE_SECONDS=60

# Public-web reading guard rails.
AGENT_WEB_TIMEOUT_SECONDS=10
AGENT_WEB_MAX_BYTES=524288
AGENT_WEB_MAX_REDIRECTS=3
# Only enable where the resolver hands out non-public addresses on purpose.
AGENT_WEB_ALLOW_PRIVATE_ADDRESSES=false

# web.research. Empty sidecar URLs mean that sidecar is not deployed: search
# falls back to user-supplied links, rendering falls back to static fetching.
AGENT_SEARXNG_BASE_URL=http://127.0.0.1:18080
AGENT_SEARXNG_LANGUAGE=zh-CN
AGENT_SEARXNG_TIMEOUT_SECONDS=10
AGENT_CRAWL4AI_BASE_URL=http://crawl4ai:11235
# The official Crawl4AI image puts every endpoint behind this token; it must
# match CRAWL4AI_API_TOKEN on the sidecar.
AGENT_CRAWL4AI_API_TOKEN=
AGENT_CRAWL4AI_TIMEOUT_SECONDS=30
# Search and rendering can come from a hosted service instead of the two
# self-hosted sidecars. Set these to `tavily` and fill in the key to switch;
# set them back to `searxng` / `crawl4ai` to return to self-hosting.
AGENT_WEB_SEARCH_PROVIDER=searxng
AGENT_WEB_RENDERER=
AGENT_TAVILY_API_KEY=
AGENT_TAVILY_BASE_URL=https://api.tavily.com
AGENT_TAVILY_SEARCH_DEPTH=fast
AGENT_TAVILY_EXTRACT_DEPTH=basic
AGENT_TAVILY_INCLUDE_RAW_CONTENT=true
AGENT_TAVILY_TIMEOUT_SECONDS=30
AGENT_WEB_RESEARCH_TIMEOUT_SECONDS=90
AGENT_WEB_RESEARCH_MIN_TEXT_CHARS=500
AGENT_WEB_RESEARCH_MAX_RESULTS=5
AGENT_WEB_RESEARCH_MAX_PAGES=2
AGENT_WEB_RESEARCH_MAX_QUERIES=3
AGENT_WEB_RESEARCH_PAGE_CHARS=8000
AGENT_WEB_RESEARCH_MAX_EVIDENCE_CHARS=60000
# Reviewed platform-name table; only these names may become search domains. The
# built-in default is services/agent/config/web-search-aliases.json and is
# resolved relative to the code, so set this only for a different table.
AGENT_WEB_RESEARCH_ALIAS_PATH=

AGENT_ANSWER_TIMEOUT_SECONDS=60
AGENT_ANSWER_MAX_OUTPUT_TOKENS=1200

# Non-task chat messages (greetings, comments, past actions) get a short reply
# instead of silence. Turning this off removes the capability from the registry,
# which is the planner's only input for whether the step can run. Replies need
# understanding to be on: without an intent there is nothing to reply to.
AGENT_CHAT_REPLY_ENABLED=true
AGENT_CHAT_REPLY_TIMEOUT_SECONDS=30
AGENT_CHAT_REPLY_MAX_OUTPUT_TOKENS=300
