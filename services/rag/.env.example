ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_DISPLAY_INDEX=knowledge_display_chunks_read
ELASTICSEARCH_PROTECTED_INDEX=knowledge_protected_chunks_read
ELASTICSEARCH_VERIFY_CERTS=false
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMS=1536

# MinerU cloud precise parsing
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
# MinIO reachability is not verified yet; use MinerU's upload URL flow first.
MINERU_SUBMIT_MODE=upload
MINERU_ENABLE_OCR=true
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_LANGUAGE=ch
MINERU_NO_CACHE=false
MINERU_CACHE_TOLERANCE_SECONDS=900
MINERU_HTTP_TIMEOUT_SECONDS=60
MINERU_RESULT_DOWNLOAD_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_TASK_MAX_WAIT_SECONDS=1800
MINERU_MAX_RETRIES=3

# MinIO source objects and RAG-derived artifacts
RAG_MINIO_ENDPOINT=
RAG_MINIO_ACCESS_KEY=
RAG_MINIO_SECRET_KEY=
RAG_MINIO_SECURE=true
RAG_MINIO_SOURCE_BUCKET=info-agent
RAG_MINIO_DERIVED_BUCKET=info-agent-rag-derived
RAG_MINIO_DERIVED_PREFIX=parsed
RAG_MINIO_PRESIGNED_URL_TTL_SECONDS=900
# Leave blank until the retention policy is confirmed.
RAG_ARTIFACT_RETENTION_DAYS=

# Preprocessing safety limits
RAG_PREPROCESS_WORK_DIR=.runtime/preprocess
RAG_PREPROCESS_MAX_FILE_BYTES=209715200
RAG_PREPROCESS_MAX_PAGES=200
RAG_PREPROCESS_MAX_UNPACK_FILES=10000
RAG_PREPROCESS_MAX_UNPACK_BYTES=1073741824

# RAG runtime
RAG_ENV=development
RAG_SERVICE_NAME=rag
RAG_HTTP_HOST=0.0.0.0
RAG_HTTP_PORT=8000
RAG_LOG_LEVEL=INFO
RAG_INTERNAL_AUTH_TOKEN=

# RAG-owned PostgreSQL state. Apply db/migrations before starting workers.
RAG_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/info_agent
RAG_DATABASE_SCHEMA=rag
RAG_DATABASE_MIN_POOL_SIZE=1
RAG_DATABASE_MAX_POOL_SIZE=10
RAG_DATABASE_CONNECT_TIMEOUT_SECONDS=5
RAG_DATABASE_COMMAND_TIMEOUT_SECONDS=10

# Service 1: IAM/authorization API. RAG must never connect to OpenFGA directly.
RAG_AUTHZ_BASE_URL=
RAG_AUTHZ_API_TOKEN=
RAG_AUTHZ_CALLER_SERVICE=rag
RAG_AUTHZ_CONNECT_TIMEOUT_SECONDS=0.2
RAG_AUTHZ_TIMEOUT_SECONDS=0.8
RAG_AUTHZ_SCOPE_CACHE_TTL_SECONDS=30
RAG_AUTHZ_SCOPE_MAX_OBJECTS=10000

# Service 2: knowledge/content HTTP API
RAG_KNOWLEDGE_BASE_URL=
RAG_KNOWLEDGE_API_TOKEN=
RAG_KNOWLEDGE_CONNECT_TIMEOUT_SECONDS=2
RAG_KNOWLEDGE_TIMEOUT_SECONDS=10

# Redis Streams
RAG_REDIS_URL=
RAG_REDIS_DATABASE=3
RAG_REDIS_USERNAME=
RAG_REDIS_PASSWORD=
RAG_REDIS_TLS=false
RAG_REDIS_INBOUND_STREAM=
RAG_REDIS_CONSUMER_GROUP=rag-workers
RAG_REDIS_CONSUMER_NAME=
RAG_REDIS_OUTBOUND_STREAM=
RAG_REDIS_DLQ_STREAM=
RAG_REDIS_BLOCK_MS=5000
RAG_REDIS_BATCH_SIZE=10
RAG_REDIS_MAX_RETRIES=3
RAG_REDIS_CLAIM_IDLE_MS=60000

# Elasticsearch connection options
# Use either username/password or API key according to the remote ES policy.
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_CA_CERT_PATH=
ELASTICSEARCH_CONNECT_TIMEOUT_SECONDS=0.3
ELASTICSEARCH_REQUEST_TIMEOUT_SECONDS=1.5
ELASTICSEARCH_MAX_RETRIES=2
ELASTICSEARCH_RETRY_ON_TIMEOUT=true
ELASTICSEARCH_MAX_CONNECTIONS=50

# Embedding provider
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMS=1536
EMBEDDING_CONNECT_TIMEOUT_SECONDS=1
EMBEDDING_TIMEOUT_SECONDS=5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=2
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SECONDS=3600

# QA LLM provider
QA_API_BASE_URL=
QA_API_KEY=
QA_MODEL=
QA_CONNECT_TIMEOUT_SECONDS=2
QA_TIMEOUT_SECONDS=45
QA_STREAM=true
QA_MAX_CONTEXT_TOKENS=6000
QA_MAX_CHUNKS=8
QA_MAX_OUTPUT_TOKENS=1200

# Optional remote reranker; disabled by default for latency.
RERANK_ENABLED=false
RERANK_API_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT_SECONDS=0.8
RERANK_TOP_N=12

# Retrieval defaults; tune with ES/embedding benchmarks.
RAG_SEARCH_DEADLINE_MS=1500
RAG_ES_QUERY_TIMEOUT_MS=500
RAG_BM25_TOP_K=24
RAG_KNN_TOP_K=24
RAG_KNN_NUM_CANDIDATES=96
RAG_RRF_K=60
RAG_RRF_KEYWORD_WEIGHT=0.5
RAG_RRF_VECTOR_WEIGHT=0.5
RAG_FINAL_TOP_K=8
RAG_MAX_CHUNKS_PER_ITEM=2
RAG_QUERY_REWRITE_ENABLED=false
RAG_QUERY_REWRITE_MAX=1
RAG_HIGHLIGHT_FINAL_ONLY=true

# Chunking and bulk indexing
RAG_CHUNKING_VERSION=v1
RAG_CHUNK_MAX_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=64
RAG_INDEX_BULK_SIZE=100
RAG_INDEX_FLUSH_INTERVAL_MS=500
RAG_INDEX_MAX_RETRIES=3

# Worker execution
RAG_WORKER_CONCURRENCY=4
RAG_WORKER_PREFETCH=10
RAG_TASK_MAX_RETRIES=3
RAG_TASK_VISIBILITY_TIMEOUT_SECONDS=900
RAG_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30

# Observability
RAG_OTEL_ENABLED=false
RAG_OTEL_EXPORTER_OTLP_ENDPOINT=
RAG_METRICS_ENABLED=true
