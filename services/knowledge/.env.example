# Local connector development. Never commit real secrets.
KNOWLEDGE_HTTP_PORT=8090
KNOWLEDGE_JWT_REQUIRED=false
KNOWLEDGE_ALLOW_DEV_AUTH=true
KNOWLEDGE_DEV_USER_ID=dev-user
KNOWLEDGE_DEV_ORGANIZATION_ID=dev-org
KNOWLEDGE_REDIS_REQUIRED=false

# Required for real Feishu OAuth. Register the same redirect URI in Feishu.
# Feishu scopes must be space-separated.
KNOWLEDGE_FEISHU_CLIENT_ID=
KNOWLEDGE_FEISHU_CLIENT_SECRET=
KNOWLEDGE_FEISHU_REDIRECT_URI=http://localhost:8090/api/knowledge/v1/connectors/feishu/callback
KNOWLEDGE_FRONTEND_URL=http://localhost:5173/profile
KNOWLEDGE_FEISHU_SCOPES=contact:user.id:readonly im:message im:chat drive:drive

# Production/persistent mode also requires these values.
KNOWLEDGE_DATABASE_URL=
KNOWLEDGE_REDIS_URL=
KNOWLEDGE_REDIS_OUTBOUND_STREAM=knowledge:ready
KNOWLEDGE_MINIO_ENDPOINT=
KNOWLEDGE_MINIO_ACCESS_KEY=
KNOWLEDGE_MINIO_SECRET_KEY=
KNOWLEDGE_MINIO_BUCKET=info-agent
KNOWLEDGE_ENCRYPTION_KEY_VERSION=v1
KNOWLEDGE_ENCRYPTION_KEYS=
KNOWLEDGE_CORE_URL=http://127.0.0.1:8080
KNOWLEDGE_CORE_SERVICE_TOKEN=
KNOWLEDGE_INTERNAL_SERVICE_TOKEN=
KNOWLEDGE_RAG_URL=http://127.0.0.1:8000
KNOWLEDGE_RAG_TOKEN=
